{
  "name": "simulateur-budgetaire",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Simulateur budgétaire pédagogique : moteur corrigé, Monte-Carlo, hypothèses sourcées.",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun tsc -b && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "test": "bun test",
    "lint": "bun --bun eslint .",
    "typecheck": "bun --bun tsc -b --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  }
}
